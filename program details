        ROUND(SUM(p.alloc_aov),2) AS prod_aov
    FROM preferred_prod_aov_detail p,
    LATERAL FLATTEN(input => p.matched_products_array) f -- FLATTEN takes the array and creates a new row for each product match
    GROUP BY ALL
),

-- Company level AOV
total_aov AS (
    SELECT
        global_co_combo_id,
        ADD_MONTHS(dt_key, -1) as dt_key,
        SUM(IFNULL(alloc_aov,0)) AS total_aov
    FROM edw_heritage_prd.dm.fact_aov_ss_vw
    GROUP BY ALL
),

-- NEW: total product ATR by dimension for Prod Reach % denominator
total_prod_atr AS (
    SELECT product, SALES_OU, SALES_OU_1, aov_band, macro_segment, renewal_fiscal_qtr,
           SUM(total_prod_atr) AS total_prod_atr
    FROM (
        SELECT pc.product,
               rd.SALES_OU, rd.SALES_OU_1,
               rd.ACCT_AOV_BAND      AS aov_band,
               rd.MACRO_SEGMENT      AS macro_segment,
               rd.RENEWAL_FISCAL_QTR AS renewal_fiscal_qtr,
               SUM(pc.prod_atr)      AS total_prod_atr
        FROM renewal_detail rd
        INNER JOIN prod_cntr pc ON pc.opp_id_15 = rd.opp_id_15
        GROUP BY 1,2,3,4,5,6

        UNION ALL

        SELECT p1.product,
               rd.SALES_OU, rd.SALES_OU_1,
               rd.ACCT_AOV_BAND      AS aov_band,
               rd.MACRO_SEGMENT      AS macro_segment,
               rd.RENEWAL_FISCAL_QTR AS renewal_fiscal_qtr,
               SUM(p1.prod_atr)      AS total_prod_atr
        FROM renewal_detail rd
        INNER JOIN fact_aov_atr_2 p1
            ON p1.cntr_id = LEFT(rd.RENEWAL_PRIOR_CNTR_ID, 15)
            AND p1.dt_key = DATE_TRUNC('month', DATEADD('month', -1, rd.RENEWAL_CLOSE_MONTH))
        WHERE rd.opp_id_15 NOT IN (SELECT DISTINCT opp_id_15 FROM prod_cntr)
        GROUP BY 1,2,3,4,5,6
    ) sub
    GROUP BY 1,2,3,4,5,6
)

SELECT
    t.*,

    -- Attrition
    ROUND(IFNULL(a.apm_attrition,0),2) AS apm_attrition,
    ROUND(IFNULL(c.cloud_attrition,0),2) AS cloud_attrition,
    ROUND(IFNULL(sa.sig_attrition,0),2) AS sig_attrition,
    
    DATE_TRUNC('month', DATEADD('month', -1,t.renewal_close_month))::DATE AS renewal_month_prior, 
    DATE_TRUNC('month', DATEADD('month', 1, t.renewal_close_month))::DATE AS renewal_month_next, 

    -- New Prod ATR fallback strategy: Prefer SELA-mapped Prod ATR, otherwise fallback to contract logic
    ROUND(pc.prod_atr,2) AS prod_atr_main,  
    ROUND(p1.prod_atr,2) AS prod_atr_contract,
    ROUND(COALESCE(pc.prod_atr, p1.prod_atr, 0), 2) AS prod_atr,

    -- Total product ATR denominator for Prod Reach %
    tp.total_prod_atr,
    
    -- Product AOV
    ROUND(IFNULL(sos.prod_aov,0),2) AS target_prod_prior_month_aov,
    ROUND(IFNULL(soe.prod_aov,0),2) AS target_prod_next_month_aov,
    ROUND(IFNULL(sis.prod_aov,0),2) AS preferred_prod_prior_month_aov,
    ROUND(IFNULL(sie.prod_aov,0),2) AS preferred_prod_next_month_aov,
    ROUND(IFNULL(tas.total_aov,0),2) AS total_prior_month_aov,
    ROUND(IFNULL(tae.total_aov,0),2) AS total_next_month_aov,
    
    MAX(a.snapshot_dt) AS data_thru_apm,
    MAX(c.snapshot_dt) AS data_thru_cloud,
    MAX(sa.snapshot_dt) AS data_thru_sig,
    MAX(tas.dt_key) AS data_thru_fact_aov
FROM programs_opty_renewals t

-- Attrition values
LEFT JOIN apm a ON a.combo_company_id = t.combo_company_id AND a.apm_criteria = t.apm_attrit_aov_map AND a.snapshot_dt = t.renewal_close_month
LEFT JOIN cloud c ON c.combo_company_id = t.combo_company_id AND c.attrition_cloud = t.cloud_attrit_map AND c.snapshot_dt = t.renewal_close_month
LEFT JOIN sig_attrition sa ON sa.combo_company_id = t.combo_company_id AND sa.snapshot_dt = t.renewal_close_month AND t.apm_attrit_aov_map = 'Signature'

-- Product ATR New Integrated SELA Logic Match + fallback join if PC misses
LEFT JOIN prod_cntr pc ON pc.opp_id_15 = t.opportunity_id AND pc.product = t.apm_attrit_aov_map
LEFT JOIN fact_aov_atr_2 p1 ON p1.cntr_id = LEFT(t.cntr_id,15) AND p1.product = t.apm_attrit_aov_map AND p1.dt_key = renewal_month_prior 

-- target product AOV 
LEFT JOIN target_prod_aov sos ON sos.global_co_combo_id = t.combo_company_id AND sos.dt_key = renewal_month_prior AND sos.aov_criteria = t.apm_attrit_aov_map
LEFT JOIN target_prod_aov soe ON soe.global_co_combo_id = t.combo_company_id AND soe.dt_key = renewal_month_next AND soe.aov_criteria = t.apm_attrit_aov_map

-- Preferred swap in product AOV
LEFT JOIN preferred_prod_aov sis ON sis.global_co_combo_id = t.combo_company_id AND sis.dt_key = renewal_month_prior AND sis.aov_criteria = t.prod_swap_in_map
LEFT JOIN preferred_prod_aov sie ON sie.global_co_combo_id = t.combo_company_id AND sie.dt_key = renewal_month_next AND sie.aov_criteria = t.prod_swap_in_map

-- Total company AOV
LEFT JOIN total_aov tas ON tas.global_co_combo_id = t.combo_company_id AND tas.dt_key = renewal_month_prior
LEFT JOIN total_aov tae ON tae.global_co_combo_id = t.combo_company_id AND tae.dt_key = renewal_month_next

--Total product ATR
LEFT JOIN total_prod_atr tp
    ON  tp.product            = t.apm_attrit_aov_map
    AND tp.SALES_OU           = t.Sales_OU
    AND tp.SALES_OU_1         = t.Sales_OU_1
    AND tp.aov_band           = t.ACCT_AOV_BAND
    AND tp.macro_segment      = t.MACRO_SEGMENT
    AND tp.renewal_fiscal_qtr = t.RENEWAL_FISCAL_QTR
    
GROUP BY ALL
